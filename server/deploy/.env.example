# Example environment for docker compose (copy to server/.env or /opt/jvpn/.env on the VPS).
# Never commit real secrets.

JVPN_IMAGE=ghcr.io/jackh54/jvpn-server:latest
JVPN_LISTEN=:443
JVPN_TRANSPORT=ws
JVPN_WS_PATH=/ws
JVPN_UOT_PATH=/dns-query
JVPN_TUN_NAME=jvpn0
JVPN_DATA_DIR=/etc/jvpn
JVPN_CERTS_DIR=/etc/letsencrypt
JVPN_CERT=/etc/letsencrypt/live/vpn.blakout.dev/fullchain.pem
JVPN_KEY=/etc/letsencrypt/live/vpn.blakout.dev/privkey.pem
JVPN_TOKEN_FILE=/etc/jvpn/token
JVPN_ADMIN_LISTEN=127.0.0.1:18080
JVPN_ADMIN_USER=admin
JVPN_ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD
# Optional SANs when using auto TLS (omit cert/key/token flags) — not used with LE paths above.
# JVPN_TLS_SAN=vpn.blakout.dev
